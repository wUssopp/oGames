@model List<oGames.Models.User>

@{
  ViewData["Title"] = "Zarządzanie użytkownikami";
}

@* 1. NAGLOWEK I PRZYCISKI *@
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
  <h2 class="page-title mb-0">Zarządzanie użytkownikami</h2>
  <div>
    <a class="btn btn-primary shadow-sm" asp-controller="AdminUsers" asp-action="AdminUsersCreate">
      Dodaj użytkownika
    </a>
    <a class="btn btn-secondary shadow-sm" asp-controller="Admin" asp-action="AdminPanel">
      Powrót
    </a>
  </div>
</div>

@* --- NOWA SEKCJA: KOMUNIKATY BŁĘDÓW (z TempData) --- *@
@if (TempData["AdminUsersError"] != null)
{
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    @TempData["AdminUsersError"]
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
}

@* 2. LISTA UZYTKOWNIKOW (TABELA) *@
<div class="card-soft">

  @* Filtr wyszukiwania *@
  <input class="form-control mb-3"
         style="max-width: 400px;"
         placeholder="Szukaj użytkownika..."
         data-table-filter="#usersTable" />

  <div class="table-responsive">
    <table class="table align-middle mb-0" id="usersTable">
      <thead>
        <tr>
          <th style="width: 50px;">ID</th>
          <th>Login</th>
          <th>Rola</th>
          <th class="text-end">Akcje</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var user in Model)
        {
          <tr>
            <td>@user.Id</td>

            @* Kolumna: Login *@
            <td>
              <a class="text-link fw-bold" asp-controller="Profile" asp-action="Profile" asp-route-id="@user.Id">
                @user.Username
              </a>
            </td>

            @* Kolumna: Rola *@
            <td>
              @if (user.Role == "ADMIN")
              {
                <span class="badge bg-danger">ADMIN</span>
              }
              else
              {
                <span class="badge bg-secondary">USER</span>
              }
            </td>

            @* Kolumna: Akcje *@
            <td class="text-end">
              <form asp-controller="AdminUsers" asp-action="AdminUsersDelete" method="post" style="display:inline;"
                    onsubmit="return confirm('Czy na pewno usunąć użytkownika: @user.Username?');">

                <input type="hidden" name="id" value="@user.Id" />
                <button type="submit" class="btn btn-sm btn-danger">Usuń</button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>