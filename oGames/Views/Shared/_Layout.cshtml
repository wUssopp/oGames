<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - oGames</title>

  @* 1. STYLE I CZCIONKI *@
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  @* Ikony Bootstrap *@
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="icon" type="image/png" href="~/img/favicon.png" />
</head>
<body class="d-flex flex-column min-vh-100">

  @* 2. NAWIGACJA (NAVBAR) *@
  <header>
    <nav class="navbar navbar-expand-md navbar-dark nav-glass mb-4 shadow-sm">
      <div class="container-fluid px-4">

        @* Logo *@
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
          <i class="bi bi-controller me-2"></i>oGames
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">

          @* Pobranie danych sesji (zmienne dostępne dla obu stron menu) *@
          @{
            var username = Context.Session.GetString("Username");
            var userId = Context.Session.GetInt32("UserId");
            var role = Context.Session.GetString("Role");
            var isAdmin = string.Equals(role, "admin", StringComparison.OrdinalIgnoreCase);
          }

          @* LEWA STRONA MENU *@
          <ul class="navbar-nav flex-grow-1">
            <li class="nav-item">
              <a class="nav-link" asp-controller="Games" asp-action="List">
                <i class="bi bi-joystick me-1"></i> Sklep
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" asp-controller="Cart" asp-action="Cart">
                <i class="bi bi-cart-fill me-1"></i> Koszyk
              </a>
            </li>

            @* Profil w lewym menu (dla zalogowanych) *@
            @if (!string.IsNullOrEmpty(username))
            {
              <li class="nav-item">
                <a class="nav-link" asp-controller="Profile" asp-action="Profile" asp-route-id="@userId">
                  <i class="bi bi-person-circle me-1"></i> Profil
                </a>
              </li>
            }

            @* Admin *@
            @if (isAdmin)
            {
              <li class="nav-item">
                <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="AdminPanel">
                  <i class="bi bi-shield-lock-fill me-1"></i> Admin
                </a>
              </li>
            }
          </ul>

          @* PRAWA STRONA MENU *@
          <ul class="navbar-nav align-items-center gap-2">

            @* Wyszukiwarka *@
            <li class="nav-item me-3">
              <form class="d-flex" role="search" asp-controller="Games" asp-action="List" method="get">
                <div class="input-group input-group-sm">
                  <input class="form-control bg-dark text-light border-secondary"
                         type="search"
                         name="q"
                         value="@Context.Request.Query["q"]"
                         placeholder="Szukaj..." />
                  <button class="btn btn-outline-secondary" type="submit">
                    <i class="bi bi-search"></i>
                  </button>
                </div>
              </form>
            </li>

            @if (!string.IsNullOrEmpty(username))
            {
              @* Zalogowany użytkownik: Witaj + Link tekstowy *@
              <li class="nav-item d-flex align-items-center gap-1">
                <span class="text-light small">Witaj,</span>
                <a class="nav-link px-0 text-primary fw-bold"
                   asp-controller="Profile" asp-action="Profile" asp-route-id="@userId">
                  @username
                </a>
              </li>

              @* Przycisk wylogowania *@
              <li class="nav-item ms-2">
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Account" asp-action="Logout" title="Wyloguj">
                  <i class="bi bi-box-arrow-right"></i>
                </a>
              </li>
            }
            else
            {
              <li class="nav-item">
                <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Zaloguj</a>
              </li>
            }
          </ul>
        </div>
      </div>
    </nav>
  </header>

  @* 3. GŁÓWNA ZAWARTOŚĆ *@
  <main role="main" class="flex-fill pb-4">
    <div class="container">
      @RenderBody()
    </div>
  </main>

  @* 4. STOPKA *@
  <footer class="footer mt-auto py-3 text-center border-top border-secondary" style="border-color: rgba(255,255,255,0.1) !important;">
    <div class="container text-muted small">
      &copy; 2026 - oGames - <a class="text-secondary text-decoration-none" asp-controller="Home" asp-action="Index">Strona główna</a>
    </div>
  </footer>

  @* 5. SKRYPTY *@
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>