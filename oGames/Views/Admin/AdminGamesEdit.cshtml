@model oGames.Models.Game

@{
  ViewData["Title"] = "Edycja gry";
}

@* 1. NAGŁÓWEK STRONY *@
<h2 class="page-title">Edytuj grę: <span class="text-primary">@Model.Title</span></h2>

@* 2. FORMULARZ EDYCJI GRY *@
<div class="card-soft">
  <form asp-controller="AdminGames" asp-action="AdminGamesEdit" method="post">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
      <label asp-for="Title" class="form-label">Tytuł</label>
      <input asp-for="Title" class="form-control" />
      <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="mb-3">
      <label asp-for="Price" class="form-label">Cena (PLN)</label>
      <input asp-for="Price" type="number" step="0.01" class="form-control" />
      <span asp-validation-for="Price" class="text-danger small"></span>
    </div>

    <div class="mb-3">
      <label asp-for="Description" class="form-label">Krótki opis</label>
      <input asp-for="Description" class="form-control" />
      <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="mb-3">
      <label asp-for="LongDescription" class="form-label">Pełny opis</label>
      <textarea asp-for="LongDescription" class="form-control" rows="6"></textarea>
      <span asp-validation-for="LongDescription" class="text-danger small"></span>
    </div>

    <div class="mb-4">
      <label asp-for="ImageDir" class="form-label">Ścieżka do zdjęć</label>
      <div class="input-group">
        <input asp-for="ImageDir" class="form-control" />
      </div>
      <div class="form-text">Zostaw puste lub wpisz nazwę folderu w wwwroot.</div>
    </div>

    <div class="d-flex gap-2">
      <button class="btn btn-warning px-4" type="submit">Zapisz zmiany</button>
      <a class="btn btn-secondary px-4" asp-controller="AdminGames" asp-action="AdminGames">Anuluj</a>
    </div>
  </form>
</div>

@* 3. SKRYPTY WALIDACJI (Client-Side) *@
@section Scripts {
  @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
  }
}